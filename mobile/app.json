{
  "expo": {
    "name": "FeedFlow",
    "slug": "feedflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F0F1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.feedflow.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F1A"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feedflow.app"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
